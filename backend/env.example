# Database Configuration
DATABASE_URL=postgresql://matlab_user:matlab_password@localhost:5432/matlab_automation
REDIS_URL=redis://localhost:6379

# MATLAB Configuration
MATLAB_PATH=/usr/local/MATLAB/R2023b
MATLAB_LICENSE_SERVER=your-license-server
MATLAB_ENGINE_TIMEOUT=300

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
APP_NAME=MATLAB Automation Platform
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# File Upload Settings
MAX_FILE_SIZE=100MB
UPLOAD_PATH=./uploads
ALLOWED_EXTENSIONS=.m,.slx,.mat,.csv,.xlsx,.json

# Hardware Integration
HARDWARE_ENABLED=false
USB_DEVICE_PATH=/dev/ttyUSB0
CAN_INTERFACE=can0
MODBUS_PORT=502

# Analytics
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=simulations

# Grafana dashboard (used by the web app for "Open in Grafana")
GRAFANA_DASHBOARD_URL=http://193.16.126.186:3005/d/simulation-dashboard/simulation-data-dashboard?orgId=1&var-bucket=simulations&var-measurement=simulation_data&from=now-7d&to=now
SIMULATION_TIMEOUT_SECONDS=3600

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true
